import tkinter as tk
import pywhatkit as kit
from datetime import datetime, timedelta

def send_message():
    """إرسال رسالة واتساب للرقم المدخل"""
    phone = entry_phone.get().strip()
    message = entry_msg.get("1.0", tk.END).strip()

    if not phone.startswith("+"):
        lbl_status.config(text="⚠️ أدخل الرقم بصيغة دولية (مثال: +212...)",
                          fg="red")
        return

    if not phone or not message:
        lbl_status.config(text="⚠️ أدخل الرقم والرسالة", fg="red")
        return

    # جدولة الرسالة بعد دقيقة من الآن
    now = datetime.now() + timedelta(minutes=1)
    hour, minute = now.hour, now.minute

    try:
        kit.sendwhatmsg(phone, message, hour, minute)
        lbl_status.config(text=f"✅ تم جدولة الرسالة إلى {phone}",
                          fg="green")
    except Exception as e:
        lbl_status.config(text=f"❌ خطأ: {e}", fg="red")

# --- واجهة التطبيق ---
root = tk.Tk()
root.title("WhatsApp Automation App")
root.geometry("400x300")
root.resizable(False, False)

# إدخال الرقم
tk.Label(root, text="📱 رقم الهاتف (+213...):").pack(pady=5)
entry_phone = tk.Entry(root, width=35, justify="center")
entry_phone.pack()

# إدخال الرسالة
tk.Label(root, text="💬 الرسالة:").pack(pady=5)
entry_msg = tk.Text(root, height=5, width=35)
entry_msg.pack()

# زر الإرسال
btn_send = tk.Button(root, text="إرسال",
                     command=send_message,
                     bg="#25D366", fg="white",
                     font=("Arial", 12, "bold"),
                     width=15)
btn_send.pack(pady=10)

# رسالة الحالة
lbl_status = tk.Label(root, text="", font=("Arial", 10))
lbl_status.pack()

root.mainloop()
